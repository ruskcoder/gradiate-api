            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginType\": \"credentials\",\n  \"loginData\": {\n    \"link\": \"https://homeaccess.example.org\",\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n  },\n  \"options\": {\n    \"term\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
